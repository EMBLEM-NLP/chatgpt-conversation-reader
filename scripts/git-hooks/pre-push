#!/bin/sh
# gcr-privacy-hook v1 (pre-push)
#
# Opt-in hook, installed by `node scripts/install-git-hooks.mjs` (never installed automatically, nothing global is set).
# Before anything leaves the machine it runs the normal GCR privacy scan on the work tree (tracked files, untracked files that
# are not ignored, and the staged diff). CI additionally scans the whole history: `node scripts/privacy-scan.mjs --history`.
# It refuses the push when the scan reports a finding AND when the scan cannot run at all (fail closed).
#
# Only shell built-ins (printf, command) run before the node check, so the refusal and its explanation work even with an empty PATH.
# Edit the original in scripts/git-hooks/, not the copy in .git/hooks/, and re-run the installer to update the copy.

gcr_say() {
  printf '%s\n' "$@" >&2
}

gcr_bypass_warning() {
  gcr_say \
    "  Bypass knowingly: git push --no-verify" \
    "  Do not bypass it unless you are certain the flagged content is synthetic or harmless. Once private conversations, databases or" \
    "  credentials are pushed they have to be treated as leaked (rotate the credential, rewrite history, tell the people who hold clones)."
}

if ! command -v node >/dev/null 2>&1; then
  gcr_say \
    "gcr privacy hook (pre-push): \`node\` was not found on PATH, so the privacy scan cannot run." \
    "The push is REFUSED (the hook fails closed, because \"could not check\" must not mean \"nothing to find\")." \
    "  Fix: install Node.js 22.16 or newer, and make sure \`node\` is on the PATH of the program that runs git."
  gcr_bypass_warning
  exit 1
fi

root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$root" ]; then
  gcr_say "gcr privacy hook (pre-push): could not find the top level of the work tree. The push is REFUSED (fail closed)."
  gcr_bypass_warning
  exit 1
fi

scanner="$root/scripts/privacy-scan.mjs"
if [ ! -f "$scanner" ]; then
  gcr_say \
    "gcr privacy hook (pre-push): $scanner does not exist (a branch without the scanner?). The push is REFUSED (fail closed)." \
    "  Fix: switch to a branch that has scripts/privacy-scan.mjs, or remove the hook with: node scripts/install-git-hooks.mjs --uninstall"
  gcr_bypass_warning
  exit 1
fi

node "$scanner" --root "$root"
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi
gcr_say ""
if [ "$status" -eq 2 ]; then
  gcr_say "gcr privacy hook (pre-push): the scanner could not run (exit status 2). If it says to run \`npm run build\`, do that first."
fi
gcr_say \
  "gcr privacy hook (pre-push): the push was REFUSED." \
  "  Fix the findings above, commit the fix, and push again. If the flagged content is already in a commit that is about to be pushed," \
  "  run \`node scripts/privacy-scan.mjs --history\` and rewrite those commits first." \
  "  A known-safe file can be listed by exact path in .privacy-scan-allow; that is reviewable, a bypass is not."
gcr_bypass_warning
exit 1
