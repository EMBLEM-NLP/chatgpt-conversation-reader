{
  "name": "@emblem-nlp/chatgpt-conversation-reader",
  "version": "0.2.0-dev.0",
  "private": true,
  "description": "EMBLEM-NLP ChatGPT Conversation Reader & Writer (GCR): offline, local-first reader for user-provided ChatGPT export data",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "gcr": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.json",
    "pretest": "npm run build:test",
    "test": "node --test --test-concurrency=2 \"dist-test/test/**/*.test.js\"",
    "smoke": "npm run build && node scripts/ci-smoke.mjs",
    "privacy-scan": "npm run build && node scripts/privacy-scan.mjs",
    "privacy-scan:history": "npm run build && node scripts/privacy-scan.mjs --history",
    "licenses": "npm run build && node scripts/licenses.mjs",
    "test:browser": "node scripts/test-browser-gated.mjs",
    "capture:cli-help": "npm run build && node scripts/capture-cli-help.mjs",
    "dump:mcp-schemas": "npm run build && node scripts/dump-mcp-schemas.mjs",
    "perf": "npm run build && node scripts/perf-baseline.mjs",
    "audit:report": "npm run build && node scripts/audit-report.mjs",
    "release:checksums": "npm run build && node scripts/release-checksums.mjs",
    "coverage-summary": "npm run build:test && node scripts/coverage-summary.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ]
}
