{
  "name": "@emblem-nlp/chatgpt-conversation-reader",
  "version": "0.2.0-dev.0",
  "private": true,
  "description": "EMBLEM-NLP ChatGPT Conversation Reader & Writer (GCR): offline, local-first reader for user-provided ChatGPT export data",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "gcr": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:test",
    "build:test": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"dist-test/test/**/*.test.js\"",
    "smoke": "node scripts/ci-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
